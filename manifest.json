{
  "manifest_version": 3,
  "name": "Page Anchors",
  "version": "1.0.0",
  "description": "Place anchor points on any webpage and jump between them with one click.",
  "author": "Page Anchors",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false
    }
  ]
}
